# Local Ollama controller defaults for a 16GB GPU.
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1536
OLLAMA_THINK=medium
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=300

# The local controller is always the default front AI.
FRONT_AI_PROVIDER=ollama
FRONT_AI_REASONING_EFFORT=high
FRONT_AI_MAX_TOKENS=2400
CONTEXT_TURNS=12
CONTEXT_MAX_CHARS=24000

# External providers are used only from the explicit research workflow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol,gpt-5.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
LLAMA_API_KEY=
META_MODEL=
EXTERNAL_AI_TIMEOUT=180

# Approval-gated outbound email. Empty values keep actual sending disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true

# Google premarketing publisher. Use a dedicated Workspace user. Never commit real values.
GOOGLE_MARKETING_ACCOUNT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_FORM_SYNC_INTERVAL=300
GOOGLE_API_TIMEOUT=30
GOOGLE_API_MAX_ATTEMPTS=3
GOOGLE_BROWSER_PORT=8010

# Direct Canva Connect API. Used by Local Supporter without Codex.
# Use a short-lived access token and a template containing TITLE/AUDIENCE/OFFER/CTA fields.
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=
CANVA_API_BASE=https://api.canva.com/rest/v1
CANVA_API_TIMEOUT=30
CANVA_API_MAX_ATTEMPTS=4

# Public operator identity shown on landing pages and verified before publication.
PUBLIC_OPERATOR_NAME=Example Operator
PUBLIC_OPERATOR_URL=https://example.com/
PUBLIC_OPERATOR_ADDRESS=Example address

# Local Cowork services. scripts/setup.ps1 generates the real secret in .env.
LOCAL_COWORK_ROOT=C:/Users/USERNAME/LocalCowork
WORKSPACE_PATH=C:/Users/USERNAME/LocalCowork/workspace
OPEN_WEBUI_PORT=3000
CPTR_PORT=8000
OPEN_WEBUI_TAG=main
CPTR_TAG=latest
WEBUI_SECRET_KEY=CHANGE_ME
CPTR_AUDIT_LOG_LEVEL=METADATA
CPTR_LOG_LEVEL=INFO
CPTR_LOG_FORMAT=text

# Optional authenticated LAN collection proxy. Set both values before enabling.
PROXY_BIND_IP=
SEBAS_PROXY_TOKEN=
SEBAS_ALLOWED_CLIENT=
