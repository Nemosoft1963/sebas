worker_processes auto;
events { worker_connections 512; }
http {
  server_tokens off;
  map_hash_bucket_size 128;
  client_max_body_size 10m;
  log_format safe '$remote_addr - $request_method $uri $status $body_bytes_sent';
  access_log /var/log/nginx/access.log safe;
  error_log /var/log/nginx/error.log warn;
  limit_req_zone $binary_remote_addr zone=sebas_api:10m rate=10r/s;
  map $http_x_sebas_token $token_ok { default 0; "${SEBAS_PROXY_TOKEN}" 1; }

  server {
    listen 8080;
    limit_req zone=sebas_api burst=20 nodelay;

    # Optional source restriction is rendered by the checked entrypoint.
    ${SEBAS_CLIENT_ACCESS_RULES}

    location = /api/health {
      if ($token_ok = 0) { return 401; }
      limit_except GET { deny all; }
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_pass http://local-voice-ai-web:8000;
    }
    location ~ "^/api/projects/[A-Za-z0-9_-]{1,64}/experience/import-success-cases$" {
      if ($token_ok = 0) { return 401; }
      limit_except POST { deny all; }
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_pass http://local-voice-ai-web:8000;
    }
    location ~ "^/api/projects/[A-Za-z0-9_-]{1,64}/agent-examples$" {
      if ($token_ok = 0) { return 401; }
      limit_except POST { deny all; }
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_pass http://local-voice-ai-web:8000;
    }
    location ~ "^/api/projects/[A-Za-z0-9_-]{1,64}/agent-examples/[A-Za-z0-9_-]{1,64}/learning/general$" {
      if ($token_ok = 0) { return 401; }
      limit_except GET POST { deny all; }
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_pass http://local-voice-ai-web:8000;
    }
    location / { return 403; }
  }
}
